---
import Base from '../layouts/Base.astro';
import LastHopBrief from '../components/LastHopBrief.astro';
import DocMeta from '../components/DocMeta.astro';
import { byGroup, flows } from '../data/flows';
import { standards } from '../data/standards';
import { REVIEWED } from '../data/site';
import { questions } from '../data/guide';

const groups = byGroup();
const drafts = standards.filter((s) => s.status === 'wg-draft' || s.status === 'draft').length;
const short = (slug: string) => flows.find((f) => f.slug === slug)!.short;

// The decision guide's first two questions, in its own words.
const principal = questions.find((q) => q.id === 'principal')!;
const human = questions.find((q) => q.id === 'human')!;
const label = (q: typeof principal, value: string) => q.options.find((o) => o.value === value)!.label;

const authority = [
  {
    id: 'person',
    tone: 'red',
    principal: 'The user is the principal',
    answer: label(principal, 'user'),
    text: 'The token names that person. The agent is the client acting for them, and their permissions set the limit.',
    then: human.title,
    branches: [
      {
        when: label(human, 'present'),
        links: [
          ['mcp-authorization', 'calling an MCP server'],
          ['authorization-code-pkce', 'calling an HTTP API, with a browser to hand'],
          ['device-authorization', 'no browser where the agent runs'],
        ],
      },
      {
        when: label(human, 'reachable'),
        links: [
          ['ciba', 'ask them on a device they already use'],
          ['step-up-authorization', 'a fresh approval for one sensitive action'],
          ['url-elicitation', 'an MCP server needs a grant from a third party'],
        ],
      },
      {
        when: label(human, 'absent'),
        note: 'Authority was delegated earlier and the agent runs on it unattended. The arrangement to be most careful with.',
        links: [
          ['authorization-code-pkce', 'consent once, then run on a refresh token'],
          ['cross-app-access', 'the company identity provider decides'],
        ],
      },
    ],
  },
  {
    id: 'agent',
    tone: 'blue',
    principal: 'The agent is the principal',
    answer: label(principal, 'self'),
    text: 'The token names the agent. Its identity comes from the platform it runs on or from a credential an administrator issued, and policy is the only control.',
    then: 'Where does its identity come from?',
    branches: [
      {
        when: 'The platform it runs on',
        links: [
          ['workload-identity-federation', 'Kubernetes or a cloud workload calling an outside API'],
          ['spiffe-workload-identity', 'service to service inside your own platform'],
        ],
      },
      { when: 'A registered client credential', links: [['client-credentials', 'a client with a key or secret of its own']] },
    ],
  },
];

const meta = [
  { label: 'Document', value: 'Independent implementation guide', note: 'Not a specification', noteHref: '/about/#independence' },
  { label: 'Covers', value: `${flows.length} flows, ${standards.length} specifications`, note: `${drafts} are still drafts`, noteHref: '/standards/' },
  { label: 'Last reviewed', value: REVIEWED, note: 'How it was checked', noteHref: '/about/#how-facts-were-checked' },
];

const sections = [
  {
    href: '/concepts/',
    title: 'Concepts',
    text: 'Principals, delegation versus impersonation, audience, proof of possession, and an annotated tour of nine tokens.',
  },
  {
    href: '/flows/',
    title: `${flows.length} flows`,
    text: 'Every flow as a sequence diagram you can step through, with the HTTP on the wire and who holds what at each step.',
  },
  {
    href: '/deployments/',
    title: 'Deployments',
    text: 'Kubernetes, managed agent platforms, desktops and CLIs, CI pipelines and sandboxes: where identity comes from in each.',
  },
  {
    href: '/standards/',
    title: 'Standards tracker',
    text: `${standards.length} RFCs, drafts and specifications with current status. ${drafts} of them are still drafts.`,
  },
];

const news = [
  ['MCP 2026-07-28', 'The protocol went stateless, deprecated Dynamic Client Registration, and made issuer validation mandatory for clients.', '/flows/mcp-authorization/'],
  ['Agents are workloads', 'The IETF WIMSE working group adopted an architecture for agent identity that composes existing standards and defines no new protocol.', '/standards/#wimse-aims'],
  ['Pod Certificates are GA', 'Kubernetes 1.37 gives every pod a native, auto-rotated X.509 identity. You bring the signer.', '/deployments/kubernetes/'],
  ['Approval can wait', 'The OAuth working group adopted Deferred Token Response: any grant may answer “not yet” while a human decides.', '/standards/#deferred-token-response'],
];
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="eyebrow">Authentication and authorization for AI agents</p>
        <h1>Who is acting, for whom, and who said they could?</h1>
        <p class="lede">
          A guide for people building and reviewing agent integrations. For each authorization flow: who holds the
          credential, whose authority it carries, and what the receiving service can verify.
        </p>
        <nav class="routes" aria-label="Start here">
          <ul>
            <li>
              <a href="/guide/">Choose an authorization flow</a>
              <span>Six questions, starting with whose authority the agent is using.</span>
            </li>
            <li>
              <a href="/concepts/#roles">Understand the roles</a>
              <span>User, agent, authorization server and resource server: what each holds and what each can verify.</span>
            </li>
            <li>
              <a href="/flows/">Browse flows and standards</a>
              <span>
                {flows.length} flows, step by step, and a <a href="/standards/">tracker of {standards.length} specifications</a>.
              </span>
            </li>
          </ul>
        </nav>
      </div>

      <LastHopBrief />

      <div class="hero-meta">
        <DocMeta items={meta} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>{principal.title}</h2>
        <p>The first question to settle. It decides whose name is on the token.</p>
      </div>
      <p class="jump">
        Two answers:{' '}
        {authority.map((a, n) => (
          <>
            {n > 0 && ' · '}
            <a href={`#authority-${a.id}`}>{a.answer}</a>
          </>
        ))}
      </p>
      <div class="grid two authority">
        {
          authority.map((a) => (
            <div class="card" id={`authority-${a.id}`}>
              <span class="chip" data-tone={a.tone}>
                {a.principal}
              </span>
              <h3>{a.answer}</h3>
              <p>{a.text}</p>
              <p class="then">{a.then}</p>
              <dl>
                {a.branches.map((b) => (
                  <div>
                    <dt>{b.when}</dt>
                    <dd>
                      {b.note && <span class="note">{b.note}</span>}
                      <ul>
                        {b.links.map(([slug, hint]) => (
                          <li>
                            <a href={`/flows/${slug}/`}>{short(slug)}</a>
                            <span class="hint">{hint}</span>
                          </li>
                        ))}
                      </ul>
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          ))
        }
      </div>
      <p class="more">
        These are the first two of the decision guide’s six questions. The other four cover what the agent calls, who
        runs that, where the agent runs and what is at stake. Chains of agents and tools have{' '}
        <a href="/flows/#g-delegation">flows of their own</a>.
      </p>
      <p class="cta">
        <a class="btn primary" href="/guide/">Answer all six questions</a>
        <a class="btn" href="/flows/">See all {flows.length} flows</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>What is here</h2>
      <div class="grid two what">
        {
          sections.map((s) => (
            <a class="card" href={s.href}>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Moving this year</h2>
        <p>As of {REVIEWED}. <a href="/standards/">Full tracker →</a></p>
      </div>
      <ul class="news">
        {
          news.map(([title, text, href]) => (
            <li>
              <a href={href}>
                <strong>{title}</strong>
                <span>{text}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Every flow</h2>
      <div class="index">
        {
          groups.map((g) => (
            <div>
              <h3>{g.title}</h3>
              <ul>
                {g.flows.map((f) => (
                  <li>
                    <a href={`/flows/${f.slug}/`}>{f.short}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    border-bottom: 1px solid var(--border);
    background: var(--hero-bg);
    padding-block: clamp(2.5rem, 7vw, 5rem) clamp(2rem, 5vw, 3.5rem);
  }
  .hero-grid {
    display: grid;
    gap: 2rem 3rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
    }
  }
  .hero h1 {
    font-size: calc(clamp(2.2rem, 4.6vw, 3.5rem) * var(--display-scale));
    max-width: 17ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.2rem 0 0;
  }

  .hero-meta {
    grid-column: 1 / -1;
  }
  .hero-meta :global(.doc-meta) {
    margin-top: 0;
  }

  /* three ways in, set as a short list of links */
  .routes ul {
    list-style: none;
    padding: 0;
    margin: 1.6rem 0 0;
    border-top: 1px solid var(--fg);
    max-width: 36rem;
  }
  .routes li {
    margin: 0;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
    display: grid;
    gap: 0.1rem;
  }
  .routes li > a {
    font-size: 1.08rem;
    font-weight: 600;
    justify-self: start;
  }
  .routes li > a::after {
    content: ' →';
  }
  .routes span {
    font-size: 0.93rem;
    color: var(--fg-muted);
  }

  .section h2 {
    margin-top: 0;
  }
  .authority .card h3 {
    margin: 0.8rem 0 0.35rem;
    font-size: 1.3rem;
  }
  .authority .then {
    margin: 1rem 0 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--border);
    font-weight: 600;
    color: var(--fg);
  }
  .authority dl {
    margin: 0.5rem 0 0;
    display: grid;
    gap: 0.6rem;
  }
  .authority dl > div {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
    gap: 0.2rem 1rem;
  }
  .authority dt {
    font-size: 0.93rem;
    color: var(--fg-muted);
  }
  .authority dd {
    margin: 0;
    font-size: 0.95rem;
  }
  .authority .note {
    display: block;
    font-size: 0.86rem;
    color: var(--fg-muted);
    margin-bottom: 0.25rem;
  }
  .authority ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .authority li {
    margin: 0 0 0.35rem;
    line-height: 1.35;
  }
  .authority .hint {
    display: block;
    font-size: 0.86rem;
    color: var(--fg-muted);
  }
  .authority .card {
    scroll-margin-top: 5rem;
  }
  /* on a phone the second answer is a long way down: offer both at the top */
  .jump {
    display: none;
    margin: -0.6rem 0 1.2rem;
    font-size: 0.95rem;
  }
  @media (max-width: 48rem) {
    .jump {
      display: block;
    }
  }
  @media (max-width: 30rem) {
    .authority dl > div {
      grid-template-columns: 1fr;
    }
  }
  .more {
    margin: 1.3rem 0 0;
    color: var(--fg-muted);
  }

  .what {
    margin-top: 1.2rem;
  }
  .what h3 {
    font-size: 1.4rem;
  }

  .news {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1.5px solid var(--fg);
  }
  .news li {
    margin: 0;
    border-bottom: 1px solid var(--border);
  }
  .news a {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 0.2rem 2rem;
    padding: 0.85rem 0;
    text-decoration: none;
  }
  .news a:hover {
    color: inherit;
  }
  .news a:hover strong {
    color: var(--accent);
  }
  .news strong {
    font-family: var(--font-heading);
    font-size: 1.16rem;
    font-weight: 560;
  }
  .news span {
    color: var(--fg-muted);
  }
  @media (max-width: 40rem) {
    .news a {
      grid-template-columns: 1fr;
    }
  }

  .index {
    display: grid;
    gap: 1.5rem 2rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    margin-top: 1.2rem;
  }
  .index h3 {
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin: 0 0 0.5rem;
    padding-bottom: 0.4rem;
    border-bottom: 1.5px solid var(--fg);
  }
  .index ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.96rem;
  }
  .index li {
    margin: 0.3rem 0;
  }
  .index a {
    text-decoration-color: var(--border-strong);
  }
  .index a:hover {
    text-decoration-color: var(--accent);
  }
</style>
