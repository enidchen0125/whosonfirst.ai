    min-width: 44rem;
  }
  .ways thead th {
    white-space: normal;
    vertical-align: bottom;
  }
  .ways tbody th {
    width: 9.5rem;
    font-family: var(--font-body);
    font-size: inherit;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg);
    white-space: normal;
    border-bottom: 1px solid var(--border);
  }
  .ways tbody tr:last-child th {
    border-bottom: 0;
  }
