---
/**
 * A misconception, stated and then corrected. Naming the wrong idea and saying
 * why it is wrong changes a reader's mind more reliably than stating the right
 * idea alone, so the lessons do it for the mistakes that are known to be
 * common. The wrong idea is in the title, in quotation marks, so that nobody
 * skimming takes it for the site's own claim.
 */
interface Props {
  /** The mistaken belief, as someone would say it. */
  belief: string;
}
const { belief } = Astro.props;
---

<aside class="mixup callout">
  <p class="callout-title">A common mix-up</p>
  <p class="belief">“{belief}”</p>
  <slot />
</aside>

<style>
  .mixup {
    max-width: var(--prose);
    font-size: 1rem;
  }
  .belief {
    margin: 0 0 0.4rem;
    font-weight: 600;
  }
  .mixup :global(p) {
    max-width: none;
  }
</style>
