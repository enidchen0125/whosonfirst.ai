---
/**
 * "What does the last hop know?" in its smallest form: one user, one agent,
 * one API, and two credentials the agent might present. The panel lists what
 * the API can establish from the request in each case.
 *
 * Radio inputs + :has(), so it needs no JavaScript, and the first arrangement
 * is a complete picture on its own. The longer comparison (five arrangements,
 * a middle tier) is LastHop.astro.
 */
import { inline } from '../lib/md';

type Status = 'available' | 'missing' | 'conditional';
const STATUS: Record<Status, string> = { available: 'Available', missing: 'Missing', conditional: 'Conditional' };

/** The three clauses of the site's question, then the proof that ties them to the sender. */
const questions = [
  { kicker: 'Who is acting', q: 'Which software is calling?' },
  { kicker: 'For whom', q: 'Which user is it for?' },
  { kicker: 'Who said they could', q: 'What did that user allow?' },
  { kicker: 'Proof', q: 'Is the sender really that software?' },
];

interface Arrangement {
  id: string;
  name: string;
  hint: string;
  /** What happens between the user and the agent. */
  ask: string;
  /** The credential on the wire between the agent and the API, and the claims worth showing. */
  credential: string;
  claims?: string[];
  rows: [Status, string][];
  verdict: string;
  link: { href: string; text: string };
}

const arrangements: Arrangement[] = [
  {
    id: 'key',
    name: 'Its own API key',
    hint: 'One key for the agent, the same for every user',
    ask: 'Asks the agent to act',
    credential: 'The agent’s API key',
    rows: [
      ['available', 'The key maps to the agent’s account.'],
      ['missing', 'Nothing the API can verify names Alice. A user ID added by the agent is only the agent’s word.'],
      ['missing', 'The key carries what an administrator gave the agent, the same for every user. Alice’s approval is not in the request.'],
      ['missing', 'A key is a bearer secret. It works for anyone who has a copy.'],
    ],
    verdict:
      'The API can limit what the agent does. It cannot tell one user’s request from another’s, or apply one user’s permissions.',
    link: { href: '/flows/client-credentials/', text: 'When the agent acts as itself' },
  },
  {
    id: 'delegated',
    name: 'A token Alice delegated',
    hint: 'Issued to the agent by an authorization server after she approved',
    ask: 'Approves access at the authorization server',
    credential: 'Access token',
    claims: ['sub=alice', 'client_id=agent'],
    rows: [
      ['available', '`client_id` names the agent the token was issued to.'],
      ['available', '`sub` names Alice. The authorization server that signed the token vouches for it.'],
      ['available', '`scope` and `aud` record what she approved and where it applies. Consent covers the scope, not each action.'],
      ['conditional', 'Only if the token is bound to a key the agent holds, with DPoP or mutual TLS. A plain bearer token works for anyone who has a copy.'],
    ],
    verdict:
      'The API can apply Alice’s permissions and the agent’s limits together, and cut off either one without the other.',
    link: { href: '/flows/authorization-code-pkce/', text: 'How the agent gets this token' },
  },
];

const nodes = [
  { label: 'User', sub: 'Alice', role: 'human' },
  { label: 'Agent', sub: 'Client', role: 'agent' },
  { label: 'API', sub: 'Resource server', role: 'resource' },
];
---

<section class="lhb" aria-labelledby="lhb-title">
  <h2 id="lhb-title">What does the last hop know?</h2>
  <p class="lhb-intro">
    A user asks an agent to call an API. What the API can establish depends on the credential the agent presents.
  </p>

  <fieldset>
    <legend>The agent presents</legend>
    <div class="lhb-choices">
      {
        arrangements.map((a, i) => (
          <label>
            <input type="radio" name="lhb" value={a.id} checked={i === 0} />
            <span class="lhb-choice">
              <strong>{a.name}</strong>
              <span>{a.hint}</span>
            </span>
          </label>
        ))
      }
    </div>
  </fieldset>

  {
    arrangements.map((a) => (
      <div class="lhb-panel" data-arrangement={a.id}>
        <div
          class="lhb-path"
          role="img"
          aria-label={`User Alice: ${a.ask}. The agent then calls the API and presents: ${[a.credential, ...(a.claims ?? [])].join(' ')}.`}
        >
          <div class={`lhb-node role-${nodes[0].role}`}>
            <strong>{nodes[0].label}</strong>
            <span>{nodes[0].sub}</span>
          </div>
          <div class="lhb-hop">
            <span class="lhb-note">{a.ask}</span>
            <span class="lhb-arrow" aria-hidden="true" />
          </div>
          <div class={`lhb-node role-${nodes[1].role}`}>
            <strong>{nodes[1].label}</strong>
            <span>{nodes[1].sub}</span>
          </div>
          <div class="lhb-hop">
            <span class="lhb-cred">
              <span>{a.credential}</span>
              {a.claims && <code>{a.claims.join(' ')}</code>}
            </span>
            <span class="lhb-arrow" aria-hidden="true" />
          </div>
          <div class={`lhb-node role-${nodes[2].role}`}>
            <strong>{nodes[2].label}</strong>
            <span>{nodes[2].sub}</span>
          </div>
        </div>

        <table>
          <caption>What the API can establish from the request</caption>
          <tbody>
            {questions.map((q, i) => (
              <tr>
                <th scope="row">
                  <span class="lhb-kicker">{q.kicker}</span>
                  {q.q}
                </th>
                <td class="lhb-status">
                  <span class={`lhb-mark is-${a.rows[i][0]}`}>{STATUS[a.rows[i][0]]}</span>
                </td>
                <td class="lhb-why" set:html={inline(a.rows[i][1])} />
              </tr>
            ))}
          </tbody>
        </table>

        <p class="lhb-verdict">
          {a.verdict}{' '}
          <a href={a.link.href}>{a.link.text} →</a>
        </p>
      </div>
    ))
  }

  <p class="lhb-foot">
    Assumes the API validates what it is given: the key against its records, or the token’s signature, issuer and
    audience. <a href="/concepts/#delegation">Compare five arrangements across a longer chain →</a>
  </p>
</section>

<style>
  .lhb {
    background: var(--bg-raised);
    border: 1px solid var(--fg);
    border-radius: var(--radius);
    padding: 1.15rem 1.25rem 1.1rem;
    /* this panel is read in place whatever colours the band around it uses */
    color: var(--fg);
  }
  h2 {
    font-size: 1.2rem;
    margin: 0 0 0.35rem;
    text-transform: none;
    letter-spacing: var(--display-tracking);
  }
  .lhb-intro {
    margin: 0 0 0.85rem;
    font-size: 0.95rem;
    color: var(--fg-muted);
    max-width: 34rem;
  }

  fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 1.1rem;
    min-width: 0;
  }
  legend,
  caption,
  .lhb-kicker {
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  legend {
    padding: 0;
    margin-bottom: 0.5rem;
  }
  .lhb-choices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0.5rem;
  }
  .lhb-choices label {
    display: block;
    cursor: pointer;
  }
  .lhb-choices input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  /* a choice looks like the control it is: a box with a radio mark */
  .lhb-choice {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.6rem;
    height: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }
  .lhb-choice::before {
    content: '';
    grid-row: 1 / span 2;
    width: 0.95rem;
    height: 0.95rem;
    margin-top: 0.2rem;
    border: 1.5px solid var(--fg);
    border-radius: 50%;
    background: var(--bg-raised);
  }
  .lhb-choice strong {
    font-size: 0.95rem;
    line-height: 1.3;
  }
  .lhb-choice span {
    grid-column: 2;
    font-size: 0.82rem;
    line-height: 1.35;
    color: var(--fg-muted);
  }
  .lhb-choices label:hover .lhb-choice {
    border-color: var(--fg);
  }
  .lhb-choices input:checked + .lhb-choice {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
    background: var(--accent-soft);
  }
  .lhb-choices input:checked + .lhb-choice::before {
    border-color: var(--accent);
    background: radial-gradient(var(--accent) 0 45%, var(--bg-raised) 50%);
  }
  .lhb-choices input:focus-visible + .lhb-choice {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .lhb-panel {
    display: none;
  }
  .lhb:has(input[value='key']:checked) [data-arrangement='key'],
  .lhb:has(input[value='delegated']:checked) [data-arrangement='delegated'] {
    display: block;
  }

  /* the path: three named parties and what passes between them */
  .lhb-path {
    display: grid;
    grid-template-columns: auto minmax(0, 0.8fr) auto minmax(0, 1.25fr) auto;
    align-items: center;
    padding: 0.1rem 0 0.9rem;
  }
  .lhb-node {
    border: 1.3px solid var(--role);
    background: var(--role-soft);
    border-radius: var(--radius);
    padding: 0.45rem 0.7rem;
    text-align: center;
    min-width: 4.6rem;
  }
  .lhb-node strong {
    display: block;
    font-size: 0.95rem;
    line-height: 1.25;
  }
  .lhb-node span {
    display: block;
    font-size: 0.78rem;
    line-height: 1.3;
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .lhb-hop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 0 0.4rem;
    min-width: 0;
  }
  .lhb-note,
  .lhb-cred {
    font-size: 0.78rem;
    line-height: 1.3;
    text-align: center;
    text-wrap: balance;
  }
  .lhb-note {
    color: var(--fg-muted);
  }
  /* what is presented, with its literal contents set as literals */
  .lhb-cred {
    display: grid;
    justify-items: center;
    gap: 0.15rem;
    font-weight: 600;
  }
  .lhb-cred code {
    font-size: 0.7rem;
    font-weight: 400;
    padding: 0.15em 0.45em;
    background: var(--bg-sunken);
    border: 0;
    border-radius: 2px;
    white-space: normal;
    word-break: normal;
  }
  .lhb-arrow {
    width: 100%;
    height: 1.5px;
    background: var(--fg);
    position: relative;
  }
  .lhb-arrow::after {
    content: '';
    position: absolute;
    right: -1px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-top: 1.5px solid var(--fg);
    border-right: 1.5px solid var(--fg);
    transform: translateY(-50%) rotate(45deg);
  }
  @media (max-width: 34rem) {
    .lhb-path {
      grid-template-columns: 1fr;
      justify-items: center;
    }
    .lhb-node {
      width: min(100%, 13rem);
    }
    .lhb-hop {
      flex-direction: row;
      gap: 0.7rem;
      padding: 0.45rem 0;
      max-width: 100%;
    }
    .lhb-arrow {
      width: 1.5px;
      height: 1.7rem;
      order: -1;
      flex: none;
    }
    .lhb-arrow::after {
      right: auto;
      left: 50%;
      top: auto;
      bottom: -1px;
      transform: translateX(-50%) rotate(135deg);
    }
    .lhb-note,
    .lhb-cred {
      text-align: left;
      justify-items: start;
    }
  }

  /* what the receiving side can establish */
  table {
    margin: 0;
    font-size: 0.9rem;
    border-top: 1px solid var(--fg);
  }
  caption {
    text-align: left;
    padding-bottom: 0.45rem;
  }
  tbody th {
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg);
    white-space: normal;
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 0.8rem 0.5rem 0;
    width: 34%;
    line-height: 1.3;
  }
  .lhb-kicker {
    display: block;
    font-size: 0.68rem;
    margin-bottom: 0.15rem;
  }
  td {
    padding: 0.5rem 0;
    line-height: 1.4;
  }
  .lhb-status {
    width: 6.6rem;
    padding-right: 0.8rem;
  }
  .lhb-why {
    color: var(--fg-muted);
    font-size: 0.86rem;
  }
  tr:last-child :is(th, td) {
    border-bottom-color: var(--fg);
  }
  /* the status is a word first; shape and colour repeat it */
  .lhb-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .lhb-mark::before {
    content: '';
    width: 0.72em;
    height: 0.72em;
    flex: none;
  }
  .is-available {
    color: var(--green);
  }
  .is-available::before {
    background: currentColor;
    border-radius: 50%;
  }
  .is-missing {
    color: var(--red);
  }
  .is-missing::before {
    box-shadow: inset 0 0 0 1.5px currentColor;
    border-radius: 50%;
  }
  .is-conditional {
    color: var(--amber);
  }
  .is-conditional::before {
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
    box-shadow: inset 0 0 0 1.5px currentColor;
    border-radius: 50%;
  }
  @media (max-width: 34rem) {
    tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--border);
    }
    tr:last-child {
      border-bottom-color: var(--fg);
    }
    tbody th,
    td {
      border: 0;
      padding: 0;
      width: auto;
    }
    .lhb-status {
      width: auto;
      padding: 0 0 0 0.8rem;
      align-self: end;
    }
    .lhb-why {
      grid-column: 1 / -1;
      padding-top: 0.3rem;
    }
  }

  .lhb-verdict {
    margin: 0.85rem 0 0;
    font-size: 0.95rem;
  }
  .lhb-foot {
    margin: 0.7rem 0 0;
    font-size: 0.86rem;
    color: var(--fg-muted);
  }
</style>
