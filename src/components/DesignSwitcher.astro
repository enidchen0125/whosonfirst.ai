---
/**
 * Exploration aid: switches the design direction for the whole site.
 * The choice is kept in localStorage and can be forced with ?direction=<id>.
 * Remove this component, and the unused direction stylesheets, once a
 * direction is chosen.
 */
import { directions } from "../data/directions";
---

<design-switcher class="dsw" hidden>
  <details>
    <summary>
      <span class="dsw-label">Design</span>
      <strong data-current>{directions[0].name}</strong>
    </summary>
    <fieldset>
      <legend class="visually-hidden">Design direction</legend>
      {
        directions.map((d) => (
          <label>
            <input type="radio" name="design-direction" value={d.id} />
            <span>
              <strong>{d.name}</strong>
              <em>{d.source}</em>
            </span>
          </label>
        ))
      }
      <a href="/styleguide/">Open the style guide →</a>
    </fieldset>
  </details>
</design-switcher>

<script>
  class DesignSwitcher extends HTMLElement {
    connectedCallback() {
      this.hidden = false;
      const root = document.documentElement;
      const inputs = [...this.querySelectorAll<HTMLInputElement>('input[type=radio]')];
      const current = this.querySelector<HTMLElement>('[data-current]')!;
      const sync = () => {
        const id = root.dataset.direction ?? inputs[0].value;
        for (const i of inputs) i.checked = i.value === id;
        current.textContent = inputs.find((i) => i.checked)?.closest('label')?.querySelector('strong')?.textContent ?? '';
      };
      sync();
      this.addEventListener('change', (e) => {
        const input = e.target as HTMLInputElement;
        if (input.name !== 'design-direction') return;
        root.dataset.direction = input.value;
        try {
          localStorage.setItem('direction', input.value);
        } catch {}
        sync();
        document.dispatchEvent(new CustomEvent('directionchange', { detail: input.value }));
      });
      // other switchers on the page (the style guide has its own) stay in step
      document.addEventListener('directionchange', sync);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') this.querySelector('details')?.removeAttribute('open');
      });
    }
  }
  customElements.define('design-switcher', DesignSwitcher);
</script>

<style>
  .dsw {
    position: fixed;
    right: max(0.75rem, env(safe-area-inset-right, 0px));
    bottom: max(0.75rem, env(safe-area-inset-bottom, 0px));
    z-index: 60;
    font-family: var(--font-body);
    font-size: 0.86rem;
    color-scheme: inherit;
  }
  details {
    background: var(--bg-raised);
    color: var(--fg);
    border: 1.5px solid var(--fg);
    border-radius: var(--radius);
    box-shadow: 3px 3px 0 color-mix(in srgb, var(--fg) 18%, transparent);
    max-width: min(19rem, calc(100vw - 1.5rem));
  }
  summary {
    list-style: none;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.45rem 0.75rem;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '▴';
    margin-left: auto;
    padding-left: 0.4rem;
    font-size: 0.7rem;
    color: var(--fg-muted);
  }
  details[open] summary::after {
    content: '▾';
  }
  .dsw-label {
    font-family: var(--font-label);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  fieldset {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 0;
    padding: 0.4rem;
    display: grid;
    gap: 0.15rem;
  }
  label {
    cursor: pointer;
    display: grid;
  }
  input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  label span {
    display: block;
    padding: 0.4rem 0.55rem;
    border-radius: var(--radius);
    border: 1px solid transparent;
  }
  label strong {
    display: block;
    font-weight: 600;
    line-height: 1.25;
  }
  label em {
    display: block;
    font-style: normal;
    font-size: 0.78rem;
    color: var(--fg-muted);
    line-height: 1.3;
  }
  label:hover span {
    border-color: var(--border-strong);
  }
  input:checked + span {
    background: var(--fg);
    color: var(--bg);
  }
  input:checked + span em {
    color: color-mix(in srgb, var(--bg) 75%, transparent);
  }
  input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  fieldset a {
    padding: 0.5rem 0.55rem 0.3rem;
    font-size: 0.82rem;
  }
  @media print {
    .dsw {
      display: none;
    }
  }
</style>
