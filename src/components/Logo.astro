---
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg
  class="logo-mark"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <!-- infield -->
  <path d="M16 3.5 28.5 16 16 28.5 3.5 16Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
  <!-- second, third, home -->
  <rect x="13.6" y="1.1" width="4.8" height="4.8" transform="rotate(45 16 3.5)" fill="var(--paper)" stroke="currentColor" stroke-width="1.4"></rect>
  <rect x="1.1" y="13.6" width="4.8" height="4.8" transform="rotate(45 3.5 16)" fill="var(--paper)" stroke="currentColor" stroke-width="1.4"></rect>
  <rect x="13.6" y="26.1" width="4.8" height="4.8" transform="rotate(45 16 28.5)" fill="var(--paper)" stroke="currentColor" stroke-width="1.4"></rect>
  <!-- first base: who? -->
  <rect x="25.4" y="12.9" width="6.2" height="6.2" transform="rotate(45 28.5 16)" fill="var(--clay)" stroke="var(--clay)" stroke-width="1.4"></rect>
</svg>
