---
/**
 * The lineup: nine fielding positions from the routine, mapped to the questions
 * an authorization decision has to answer. Hovering or focusing a position
 * highlights its row and vice versa.
 */
import { inline } from '../lib/md';

interface Pos {
  id: string;
  abbr: string;
  name: string;
  x: number;
  y: number;
  tone: string;
  question: string;
  answer: string;
  /** label placement relative to the marker */
  dx?: number;
  dy?: number;
  anchor?: 'start' | 'middle' | 'end';
}

const positions: Pos[] = [
  {
    id: 'who',
    abbr: '1B',
    name: 'Who',
    x: 318,
    y: 226,
    tone: 'red',
    question: 'Whose authority is this?',
    answer: 'The subject of the token: `sub`. A person, or the agent itself.',
    dx: 16,
    dy: 4,
    anchor: 'start',
  },
  {
    id: 'what',
    abbr: '2B',
    name: 'What',
    x: 210,
    y: 124,
    tone: 'blue',
    question: 'What software is acting?',
    answer: '`client_id`, the `act` claim, and the workload identity of the process making the call.',
    dx: 16,
    dy: -8,
    anchor: 'start',
  },
  {
    id: 'idk',
    abbr: '3B',
    name: 'I Don’t Know',
    x: 102,
    y: 226,
    tone: 'green',
    question: 'Does the resource know the first two?',
    answer: 'The audience, `aud`, and whether Who and What survive all the way to the last hop.',
    dx: -16,
    dy: 4,
    anchor: 'end',
  },
  {
    id: 'why',
    abbr: 'LF',
    name: 'Why',
    x: 86,
    y: 104,
    tone: 'violet',
    question: 'What is it for?',
    answer: '`scope`, `authorization_details`, and transaction context.',
    dx: 0,
    dy: -16,
    anchor: 'middle',
  },
  {
    id: 'because',
    abbr: 'CF',
    name: 'Because',
    x: 210,
    y: 52,
    tone: 'violet',
    question: 'On what grounds?',
    answer: 'A user’s consent, an administrator’s policy, or a signed mandate. Something outside the agent said yes.',
    dx: 0,
    dy: -16,
    anchor: 'middle',
  },
  {
    id: 'tomorrow',
    abbr: 'P',
    name: 'Tomorrow',
    x: 210,
    y: 232,
    tone: 'neutral',
    question: 'When does it stop?',
    answer: '`exp`, and whether anyone can revoke it sooner.',
    dx: 0,
    dy: 26,
    anchor: 'middle',
  },
  {
    id: 'today',
    abbr: 'C',
    name: 'Today',
    x: 210,
    y: 346,
    tone: 'neutral',
    question: 'How fresh is it?',
    answer: '`iat`, `auth_time` and `acr`: when and how strongly the person last proved who they are.',
    dx: 16,
    dy: 4,
    anchor: 'start',
  },
  {
    id: 'darn',
    abbr: 'SS',
    name: 'I Don’t Give a Darn',
    x: 150,
    y: 166,
    tone: 'amber',
    question: 'Does it matter who holds it?',
    answer: 'A bearer token works for anyone. A token with a `cnf` claim works only for the holder of a key.',
    dx: -14,
    dy: -10,
    anchor: 'end',
  },
  {
    id: 'nobody',
    abbr: 'RF',
    name: '(never named)',
    x: 334,
    y: 104,
    tone: 'none',
    question: 'Which agent, exactly?',
    answer:
      'The routine never names the right fielder. Most tokens never name the agent either: it hides behind the application that hosts it. Several current drafts are trying to fix that.',
    dx: 0,
    dy: -16,
    anchor: 'middle',
  },
];
---

<line-up class="lu">
  <svg viewBox="-66 0 552 380" role="group" aria-label="A baseball field with nine positions, each standing for one question about an agent’s authority. The same content follows as a table.">
    <!-- outfield + foul lines -->
    <path class="lu-grass" d="M210 338 L24 152 Q210 -70 396 152 Z"></path>
    <path class="lu-line" d="M210 338 L24 152 M210 338 L396 152"></path>
    <path class="lu-line" d="M24 152 Q210 -70 396 152"></path>
    <!-- infield -->
    <path class="lu-dirt" d="M210 338 L318 230 L210 122 L102 230 Z"></path>
    <path class="lu-line strong" d="M210 338 L318 230 L210 122 L102 230 Z"></path>
    <circle class="lu-mound" cx="210" cy="232" r="13"></circle>
    <!-- bases -->
    <rect class="lu-base" x="312" y="224" width="12" height="12" transform="rotate(45 318 230)"></rect>
    <rect class="lu-base" x="204" y="116" width="12" height="12" transform="rotate(45 210 122)"></rect>
    <rect class="lu-base" x="96" y="224" width="12" height="12" transform="rotate(45 102 230)"></rect>
    <path class="lu-base" d="M204 332h12v6l-6 6-6-6z"></path>

    {
      positions.map((p) => (
        <g class={`lu-pos tone-${p.tone}`} data-pos={p.id} tabindex="0" role="button" aria-label={`${p.name}: ${p.question}`}>
          <circle class="lu-hit" cx={p.x} cy={p.y} r="24" />
          <circle class="lu-dot" cx={p.x} cy={p.y} r="10.5" />
          <text class="lu-abbr" x={p.x} y={p.y + 3.4} text-anchor="middle">
            {p.abbr}
          </text>
          <text class="lu-name" x={p.x + (p.dx ?? 0)} y={p.y + (p.dy ?? 0)} text-anchor={p.anchor ?? 'start'}>
            {p.name}
          </text>
        </g>
      ))
    }
  </svg>

  <div class="lu-table">
    <table>
      <thead>
        <tr>
          <th scope="col">Position</th>
          <th scope="col">The question</th>
          <th scope="col">Where the answer lives</th>
        </tr>
      </thead>
      <tbody>
        {
          positions.map((p) => (
            <tr class={`tone-${p.tone}`} data-row={p.id}>
              <th scope="row">
                <span class="lu-chip">{p.abbr}</span>
                {p.name}
              </th>
              <td class="q">{p.question}</td>
              <td set:html={inline(p.answer)} />
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</line-up>

<script>
  class LineUp extends HTMLElement {
    connectedCallback() {
      const set = (id: string | null) => {
        this.querySelectorAll<HTMLElement>('[data-pos], [data-row]').forEach((el) => {
          const key = el.dataset.pos ?? el.dataset.row;
          el.classList.toggle('is-on', id !== null && key === id);
        });
        this.classList.toggle('has-on', id !== null);
      };
      let pinned: string | null = null;
      const idOf = (t: EventTarget | null) => {
        const el = (t as Element | null)?.closest<HTMLElement>('[data-pos], [data-row]');
        return el ? (el.dataset.pos ?? el.dataset.row ?? null) : null;
      };
      this.addEventListener('pointerover', (e) => {
        const id = idOf(e.target);
        if (id) set(id);
      });
      this.addEventListener('pointerout', () => set(pinned));
      this.addEventListener('focusin', (e) => set(idOf(e.target)));
      this.addEventListener('focusout', () => set(pinned));
      this.addEventListener('click', (e) => {
        const id = idOf(e.target);
        pinned = id && id !== pinned ? id : null;
        set(pinned);
      });
      this.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        const id = idOf(e.target);
        if (!id) return;
        e.preventDefault();
        pinned = id !== pinned ? id : null;
        set(pinned);
      });
    }
  }
  customElements.define('line-up', LineUp);
</script>

<style>
  .lu {
    display: grid;
    gap: 1.5rem 2.5rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .lu {
      grid-template-columns: minmax(0, 29rem) minmax(0, 1fr);
    }
  }
  svg {
    display: block;
    width: 100%;
    max-width: 31rem;
    margin-inline: auto;
    height: auto;
    font-family: var(--font-body);
  }
  .lu-grass {
    fill: var(--green-soft);
  }
  .lu-dirt {
    fill: var(--red-soft);
  }
  .lu-line {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1.2;
  }
  .lu-line.strong {
    stroke: var(--fg);
    stroke-width: 1.4;
  }
  .lu-mound {
    fill: var(--bg);
    stroke: var(--border-strong);
  }
  .lu-base {
    fill: var(--bg-raised);
    stroke: var(--fg);
    stroke-width: 1.3;
  }

  .tone-red {
    --tone: var(--red);
  }
  .tone-blue {
    --tone: var(--blue);
  }
  .tone-green {
    --tone: var(--green);
  }
  .tone-violet {
    --tone: var(--violet);
  }
  .tone-amber {
    --tone: var(--amber);
  }
  .tone-neutral {
    --tone: var(--fg);
  }
  .tone-none {
    --tone: var(--fg-subtle);
  }

  .lu-pos {
    cursor: pointer;
    outline: none;
  }
  .lu-hit {
    fill: transparent;
  }
  .lu-dot {
    fill: var(--bg-raised);
    stroke: var(--tone);
    stroke-width: 1.8;
    transition: fill 0.12s;
  }
  .tone-none .lu-dot {
    stroke-dasharray: 3 3;
  }
  .lu-abbr {
    font-family: var(--font-mono);
    font-size: 8.5px;
    font-weight: 500;
    fill: var(--tone);
    pointer-events: none;
  }
  .lu-name {
    font-family: var(--font-display);
    font-style: var(--display-italic);
    font-size: 14px;
    font-weight: 600;
    fill: var(--fg);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .tone-none .lu-name {
    fill: var(--fg-subtle);
    font-weight: 400;
  }
  .lu-pos.is-on .lu-dot,
  .lu-pos:focus-visible .lu-dot {
    fill: var(--tone);
  }
  .lu-pos.is-on .lu-abbr,
  .lu-pos:focus-visible .lu-abbr {
    fill: var(--bg-raised);
  }
  .lu-pos:focus-visible .lu-dot {
    stroke: var(--fg);
  }
  .lu.has-on .lu-pos:not(.is-on) {
    opacity: 0.45;
  }

  .lu-table {
    overflow-x: auto;
  }
  table {
    margin: 0;
    font-size: 0.92rem;
    min-width: 30rem;
  }
  tbody th {
    font-family: var(--font-display);
    font-style: var(--display-italic);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg);
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  tbody tr {
    cursor: default;
    transition: background 0.12s;
  }
  tbody tr.is-on {
    background: color-mix(in srgb, var(--tone) 12%, transparent);
  }
  .lu.has-on tbody tr:not(.is-on) {
    opacity: 0.55;
  }
  .lu-chip {
    display: inline-grid;
    place-items: center;
    min-width: 1.9rem;
    height: 1.35rem;
    margin-right: 0.5rem;
    padding: 0 0.3rem;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.66rem;
    font-weight: 500;
    color: var(--tone);
    border: 1.3px solid var(--tone);
    border-radius: 3px;
    vertical-align: 0.1em;
  }
  td.q {
    font-weight: 500;
  }
  td {
    padding-block: 0.5rem;
  }
</style>
