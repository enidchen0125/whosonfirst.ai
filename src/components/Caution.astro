---
/**
 * A warning about something a reader must not build.
 *
 * Lessons show wrong approaches beside right ones, and a reader who skims can
 * take a comparison for a menu. Where one of the things compared is dangerous
 * and not merely weaker, this says so beside it: the label says what kind of
 * box this is, and the title is the instruction itself, as a sentence.
 *
 * Use it sparingly. A page where everything is a warning has none.
 */
import WarnIcon from "./WarnIcon.astro";

interface Props {
  /** The instruction, as a sentence: "Never …" or "Do not …". */
  title: string;
}
const { title } = Astro.props;
---

<aside class="caution callout" data-tone="red">
  <p class="callout-title">
    <WarnIcon size="0.9rem" />
    Do not build this
  </p>
  <p class="rule">{title}</p>
  <slot />
</aside>

<style>
  .caution {
    max-width: var(--prose);
    font-size: 1rem;
  }
  .caution .callout-title {
    display: flex;
    align-items: center;
    gap: 0.4em;
    color: var(--red);
    font-weight: 600;
  }
  .rule {
    margin: 0 0 0.5rem;
    font-weight: 600;
  }
  .caution :global(p),
  .caution :global(ul) {
    max-width: none;
  }
  .caution :global(li) {
    margin-bottom: 0.3rem;
  }
</style>
