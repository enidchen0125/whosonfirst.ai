---
/**
 * "What can the API verify?" as a compact demonstration for the home page:
 * a credential selector, the user → agent → API path, what the API does with
 * the credential, three verdicts, one consequence, what is not proven, and
 * one way on. The fourth check, the full explanations, and what refusing and
 * revoking take are in VerifyDetail on the Concepts page, from the same data.
 *
 * The path carries one short label under each arrow. What the credential
 * contains sits on a line of its own beneath the path, so it never has to
 * fit between two boxes.
 *
 * Radio inputs + :has(), so it needs no JavaScript, and the first credential
 * is a complete picture on its own.
 */
import { checks, credentials, VERDICT_LABEL } from "../data/verify";
import { inline } from "../lib/md";

const shown = checks.filter((c) => c.compact);
---

<section class="vb" aria-labelledby="vb-title">
  <h2 id="vb-title">What can the API verify?</h2>

  <fieldset>
    <legend>The agent presents</legend>
    <div class="vb-choices">
      {
        credentials.map((c, i) => (
          <label>
            <input type="radio" name="vb" value={c.id} checked={i === 0} />
            <span>{c.name}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  {
    credentials.map((c) => (
      <div class="vb-panel" data-credential={c.id}>
        <div
          class="vb-path"
          role="img"
          aria-label={`Alice, the user, ${c.askDetail.toLowerCase()}. The agent then calls the API and presents: ${(c.sample ?? c.onWire).toLowerCase()}.`}
        >
          <div class="vb-node role-human">
            <strong>User</strong>
            <span>Alice</span>
          </div>
          <span class="vb-arrow" aria-hidden="true" />
          <div class="vb-node role-agent">
            <strong>Agent</strong>
            <span>Client</span>
          </div>
          <span class="vb-arrow" aria-hidden="true" />
          <div class="vb-node role-resource">
            <strong>API</strong>
            <span>Resource server</span>
          </div>
          <span class="vb-label vb-l1">{c.ask}</span>
          <span class="vb-label vb-l2">{c.onWire}</span>
        </div>

        <p class="vb-reads">
          <strong>{c.sample ?? c.onWire}{c.claims ? '' : '.'}</strong>{' '}
          {c.claims && <span class="vb-claims">{c.claims.map((claim) => <code>{claim}</code>)}</span>}
          {c.reads}
        </p>

        <table>
          <caption class="visually-hidden">What the API can verify when the agent presents: {c.name}</caption>
          <tbody>
            {shown.map((q) => {
              const r = c.results[q.id];
              return (
                <tr>
                  <th scope="row">{q.question}</th>
                  <td class="vb-verdict">
                    <span class={`vb-mark is-${r.verdict}`}>{VERDICT_LABEL[r.verdict]}</span>
                  </td>
                  <td class="vb-why" set:html={inline(r.brief)} />
                </tr>
              );
            })}
          </tbody>
        </table>

        <p class="vb-consequence">{c.consequence}</p>
        <p class="vb-boundary">{c.boundary}</p>
      </div>
    ))
  }

  <p class="vb-more">
    <a href="/concepts/#verify">How verification works, and what it doesn’t prove</a>
  </p>
</section>

<style>
  .vb {
    background: var(--bg-raised);
    border: 1px solid var(--fg);
    border-radius: var(--radius);
    padding: 1.05rem 1.2rem 1rem;
    /* this panel is read in place whatever colors the band around it uses */
    color: var(--fg);
  }
  h2 {
    font-size: 1.2rem;
    margin: 0 0 0.75rem;
    text-transform: none;
    letter-spacing: var(--display-tracking);
  }

  fieldset {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
    border: 0;
    padding: 0;
    margin: 0 0 0.9rem;
    min-width: 0;
  }
  legend {
    float: left;
    padding: 0;
    margin: 0;
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  /* one control with two positions */
  .vb-choices {
    display: inline-flex;
    flex-wrap: wrap;
    border: 1px solid var(--fg);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .vb-choices label {
    cursor: pointer;
    flex: 1 1 auto;
  }
  .vb-choices label + label {
    border-left: 1px solid var(--fg);
  }
  .vb-choices input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .vb-choices span {
    display: block;
    padding: 0.5rem 0.8rem;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.25;
    text-align: center;
    background: var(--bg-raised);
  }
  .vb-choices label:hover span {
    background: var(--bg-sunken);
  }
  .vb-choices input:checked + span {
    background: var(--fg);
    color: var(--bg);
  }
  .vb-choices input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }

  /* one credential at a time; a browser without :has() shows both, one after the other */
  .vb-panel + .vb-panel {
    margin-top: 1.2rem;
  }
  @supports selector(:has(*)) {
    .vb-panel {
      display: none;
    }
    .vb-panel + .vb-panel {
      margin-top: 0;
    }
    .vb:has(input[value='key']:checked) [data-credential='key'],
    .vb:has(input[value='delegated']:checked) [data-credential='delegated'] {
      display: block;
    }
  }

  /* The path: three named parties in a row, joined by arrows. Each arrow's
     label sits in a row of its own beneath, centered under the arrow, where it
     can be wider than the arrow without touching a box. */
  .vb-path {
    display: grid;
    grid-template-columns: auto minmax(2.4rem, 1fr) auto minmax(2.4rem, 1.5fr) auto;
    align-items: center;
    row-gap: 0.3rem;
    padding-bottom: 0.75rem;
  }
  .vb-node {
    grid-row: 1;
    border: 1.3px solid var(--role);
    background: var(--role-soft);
    border-radius: var(--radius);
    padding: 0.4rem 0.65rem;
    text-align: center;
  }
  .vb-node strong {
    display: block;
    font-size: 0.95rem;
    line-height: 1.25;
  }
  .vb-node span {
    display: block;
    font-size: 0.78rem;
    line-height: 1.3;
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .vb-arrow {
    grid-row: 1;
    height: 1.5px;
    margin-inline: 0.3rem;
    background: var(--fg);
    position: relative;
  }
  .vb-arrow::after {
    content: '';
    position: absolute;
    right: -1px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-top: 1.5px solid var(--fg);
    border-right: 1.5px solid var(--fg);
    transform: translateY(-50%) rotate(45deg);
  }
  .vb-label {
    grid-row: 2;
    justify-self: center;
    white-space: nowrap;
    font-size: 0.84rem;
    line-height: 1.3;
  }
  .vb-l1 {
    grid-column: 2;
    color: var(--fg-muted);
  }
  .vb-l2 {
    grid-column: 4;
    font-weight: 600;
  }
  /* on a phone the roles' second names give way so the three boxes stay on one line */
  @media (max-width: 30rem) {
    .vb-node {
      padding-inline: 0.5rem;
    }
    .vb-node:not(.role-human) span {
      display: none;
    }
  }

  /* what the credential is and how the API reads it: the condition for the verdicts below */
  .vb-reads {
    margin: 0 0 0.85rem;
    padding: 0.5rem 0.7rem;
    background: var(--bg-sunken);
    border-radius: var(--radius);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  /* the claims get a line to themselves; each stays whole and they wrap as units */
  .vb-claims {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.3rem;
    margin: 0.25rem 0 0.3rem;
  }
  .vb-claims code {
    padding: 0.05em 0.4em;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 2px;
    font-size: 0.82rem;
    white-space: nowrap;
  }

  /* three verdicts: the question, the answer as a word, and what it rests on */
  table {
    margin: 0;
    border-top: 1px solid var(--fg);
    border-bottom: 1px solid var(--fg);
  }
  tbody th {
    font-family: var(--font-body);
    font-size: 0.93rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--fg);
    white-space: normal;
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 0.8rem 0.5rem 0;
    width: 40%;
    line-height: 1.3;
  }
  td {
    padding: 0.5rem 0;
    line-height: 1.35;
  }
  .vb-verdict {
    width: 3.4rem;
    padding-right: 0.8rem;
  }
  .vb-why {
    color: var(--fg-muted);
    font-size: 0.88rem;
  }
  tr:last-child :is(th, td) {
    border-bottom: 0;
  }
  /* the verdict is a word first; shape and color repeat it */
  .vb-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-label);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .vb-mark::before {
    content: '';
    width: 0.7em;
    height: 0.7em;
    flex: none;
    border-radius: 50%;
  }
  .is-yes {
    color: var(--green);
  }
  .is-yes::before {
    background: currentColor;
  }
  .is-no {
    color: var(--red);
  }
  .is-no::before {
    box-shadow: inset 0 0 0 1.5px currentColor;
  }
  @media (max-width: 30rem) {
    tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--border);
    }
    tr:last-child {
      border-bottom: 0;
    }
    tbody th,
    td {
      border: 0;
      padding: 0;
      width: auto;
    }
    .vb-verdict {
      width: auto;
      padding: 0 0 0 0.8rem;
    }
    .vb-why {
      grid-column: 1 / -1;
      padding-top: 0.15rem;
    }
  }

  .vb-consequence {
    margin: 0.8rem 0 0;
    font-size: 0.98rem;
    font-weight: 500;
  }
  /* the limit of everything above, kept beside it */
  .vb-boundary {
    margin: 0.35rem 0 0;
    font-size: 0.92rem;
    color: var(--fg-muted);
  }
  .vb-more {
    margin: 0.5rem 0 0;
    font-size: 0.92rem;
  }
  .vb-more a::after {
    content: ' →';
  }
</style>
