---
/**
 * The warning sign: a filled triangle with an exclamation mark cut out of it.
 *
 * It marks something a reader must not build, wherever saying so in words would
 * crowd a control: on a figure's button the sign stands alone, and beside the
 * words elsewhere it shows what the sign on the button means.
 *
 * It takes the color of the text around it, and the mark is a hole, so whatever
 * is behind shows through: it reads on a button in either state and in either
 * theme. It is decoration to assistive technology. Whoever uses it supplies the
 * words, visible or hidden.
 */
interface Props {
  /** Any CSS length. Defaults to the size of the text around it. */
  size?: string;
}
const { size = "1em" } = Astro.props;
---

<svg
  viewBox="0 0 16 16"
  style={`width:${size};height:${size}`}
  fill="currentColor"
  fill-rule="evenodd"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M8.9 2.6 14.6 12.6Q15.2 14 13.9 14H2.1Q.8 14 1.4 12.6L7.1 2.6Q8 1.1 8.9 2.6ZM7.25 5.9h1.5v4.2h-1.5ZM8 11.05a.85.85 0 1 0 0 1.7.85.85 0 1 0 0-1.7Z"
  ></path>
</svg>

<style>
  svg {
    flex: none;
    display: block;
  }
</style>
