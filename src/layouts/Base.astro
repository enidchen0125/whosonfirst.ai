---
import "@fontsource-variable/fraunces/opsz.css";
import "@fontsource-variable/fraunces/opsz-italic.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/400-italic.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
// fonts for the other design directions (only downloaded when a direction uses them)
import "@fontsource-variable/big-shoulders-display";
import "@fontsource/barlow/400.css";
import "@fontsource/barlow/400-italic.css";
import "@fontsource/barlow/500.css";
import "@fontsource/barlow/600.css";
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource-variable/archivo/wdth-italic.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "@fontsource/ibm-plex-mono/400-italic.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../styles/directions/scorecard.css";
import "../styles/directions/scoreboard.css";
import "../styles/directions/linemap.css";
import "../styles/directions/draft.css";
import "../styles/directions/draft01.css";
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import DesignSwitcher from "../components/DesignSwitcher.astro";
import { directions } from "../data/directions";
import { REVIEWED } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const SITE = "Who's on First";
const {
  title,
  description = "A field guide to authentication and authorization for AI agents: the flows, the deployments, and the standards — with and without a human in the loop.",
} = Astro.props;
const fullTitle = title ? `${title} — ${SITE}` : `${SITE} — auth for AI agents`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// The task most readers arrive with comes first, and stays in reach on a phone.
const QUICK = { href: "/guide/", label: "Choose a flow" };
const nav = [
  QUICK,
  { href: "/flows/", label: "Flows" },
  { href: "/concepts/", label: "Concepts" },
  { href: "/deployments/", label: "Deployments" },
  { href: "/standards/", label: "Standards" },
  { href: "/glossary/", label: "Glossary" },
];
const path = Astro.url.pathname;
const directionIds = directions.map((d) => d.id);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#f7f3ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e141a" media="(prefers-color-scheme: dark)" />
    <script is:inline define:vars={{ directionIds }}>
      (() => {
        const root = document.documentElement;
        try {
          const t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') root.dataset.theme = t;
        } catch {}
        // design direction (exploration): ?direction=<id> wins and is remembered
        try {
          const asked = new URLSearchParams(location.search).get('direction');
          const d = directionIds.includes(asked) ? asked : localStorage.getItem('direction');
          if (directionIds.includes(d)) root.dataset.direction = d;
          if (directionIds.includes(asked)) localStorage.setItem('direction', asked);
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/">
          <Logo />
          <span class="wordmark">who’s on first<span class="tld">.ai</span></span>
          <span class="visually-hidden">, home</span>
        </a>
        <a class="quick" href={QUICK.href} aria-current={path.startsWith(QUICK.href) ? 'page' : undefined}>
          {QUICK.label}
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>Menu</button>
        <nav id="site-nav" aria-label="Primary">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <button class="theme" type="button" title="Switch colour theme">
          <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
            <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5Z" fill="currentColor"></path>
          </svg>
          <span class="theme-text">Switch colour theme</span>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <a class="brand" href="/">
            <Logo size={22} />
            <span class="wordmark">who’s on first<span class="tld">.ai</span></span>
          </a>
          <p>
            A field guide to authentication and authorization for AI agents. Who is acting, on whose behalf, and
            who said they could.
          </p>
        </div>
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/styleguide/">Style guide</a></li>
          <li><a href="/about/">About</a></li>
        </ul>
        <p class="fine">
          Standards status last reviewed {REVIEWED}. Drafts move quickly: check the linked source before you build
          on one.
        </p>
      </div>
    </footer>

    <DesignSwitcher />

    <script>
      // The phone menu. Without this script the navigation is simply shown in full.
      const header = document.querySelector<HTMLElement>('.site-header')!;
      const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
      const setOpen = (open: boolean) => {
        header.toggleAttribute('data-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.textContent = open ? 'Close' : 'Menu';
      };
      toggle.hidden = false;
      header.dataset.js = '';
      toggle.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
      header.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && header.hasAttribute('data-open')) {
          setOpen(false);
          toggle.focus();
        }
      });
      header.querySelector('nav')!.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a')) setOpen(false);
      });
      document.addEventListener('click', (e) => {
        if (!header.contains(e.target as Node)) setOpen(false);
      });
      window.matchMedia('(min-width: 62.01rem)').addEventListener('change', () => setOpen(false));

      const btn = document.querySelector<HTMLButtonElement>('.theme');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const current =
          root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 0.5rem;
    top: -4rem;
    z-index: 100;
    background: var(--fg);
    color: var(--bg);
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius);
  }
  .skip:focus {
    top: 0.5rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.5rem 1.5rem;
    min-height: 3.5rem;
    flex-wrap: wrap;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--fg);
    margin-right: auto;
    padding-block: 0.6rem;
  }
  .wordmark {
    font-family: var(--font-display);
    font-style: var(--display-italic);
    font-weight: 600;
    font-size: 1.16rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .tld {
    font-family: var(--font-mono);
    font-style: normal;
    font-weight: 500;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin-left: 0.1em;
  }
  nav ul {
    display: flex;
    gap: 0.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav li {
    margin: 0;
  }
  nav a {
    display: block;
    font-family: var(--font-label);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fg-muted);
    padding: 0.55rem 0.6rem;
    border-radius: var(--radius);
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--fg);
    background: var(--bg-sunken);
  }
  nav a[aria-current='page'] {
    color: var(--fg);
    box-shadow: inset 0 -2px 0 var(--accent);
    border-radius: 0;
  }
  .theme {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
    flex: none;
  }
  .theme:hover {
    background: var(--bg-sunken);
  }

  .quick,
  .menu-toggle {
    display: none;
  }
  /* beside the navigation the theme button is an icon; its name is still there to be read */
  .theme-text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Phone and tablet: the brand, the one task link and a menu button. Every
     destination is one tap away and none is off the edge of the screen. */
  @media (max-width: 62rem) {
    .bar {
      gap: 0 0.7rem;
    }
    /* one row: the brand takes what is left after the two controls */
    .site-header[data-js] .bar {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      align-items: center;
    }
    .site-header[data-js] .brand {
      margin-right: 0;
      min-width: 0;
      gap: 0.45rem;
    }
    .site-header[data-js] :is(nav, .theme) {
      grid-column: 1 / -1;
    }
    .quick {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      font-size: 0.88rem;
      font-weight: 500;
      white-space: nowrap;
      text-decoration-thickness: 1px;
    }
    .quick[aria-current='page'] {
      text-decoration-thickness: 2px;
    }
    .menu-toggle:not([hidden]) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 4rem;
      min-height: 2.75rem;
      padding: 0 0.7rem;
      border: 1px solid var(--fg);
      border-radius: var(--radius);
      background: var(--bg-raised);
      color: var(--fg);
      font-family: var(--font-label);
      font-size: 0.8rem;
      font-weight: 500;
      cursor: pointer;
    }
    .menu-toggle[aria-expanded='true'] {
      background: var(--fg);
      color: var(--bg);
    }
    nav {
      order: 3;
      width: 100%;
    }
    nav ul {
      flex-wrap: wrap;
    }
    /* with the script running, the list and the theme control wait behind the button */
    .site-header[data-js] nav,
    .site-header[data-js] .theme {
      display: none;
    }
    .site-header[data-js][data-open] nav {
      display: block;
      border-top: 1px solid var(--border);
    }
    .site-header[data-js] nav ul {
      display: block;
    }
    .site-header[data-js] nav a {
      display: flex;
      align-items: center;
      min-height: 3rem;
      padding: 0;
      font-size: 0.86rem;
      color: var(--fg);
      border-bottom: 1px solid var(--border);
      border-radius: 0;
    }
    .site-header[data-js] nav a[aria-current='page'] {
      box-shadow: inset 3px 0 0 var(--accent);
      padding-left: 0.8rem;
    }
    .site-header[data-js][data-open] .theme {
      order: 4;
      display: flex;
      justify-content: flex-start;
      gap: 0.7rem;
      width: 100%;
      height: auto;
      min-height: 3rem;
      padding: 0;
      border: 0;
      border-radius: 0;
      font: inherit;
      font-size: 0.92rem;
    }
    .site-header[data-js][data-open] .theme-text {
      position: static;
      width: auto;
      height: auto;
      clip-path: none;
    }
    /* without the script the whole list is shown, so the shortcut would only repeat it */
    .site-header:not([data-js]) .quick {
      display: none;
    }
  }
  /* on a phone the name drops its suffix and steps down a size to leave room */
  @media (max-width: 30rem) {
    .tld {
      display: none;
    }
    .site-header .wordmark {
      font-size: 0.9rem;
    }
    .site-header .brand :global(svg) {
      width: 24px;
      height: 24px;
    }
    .site-header[data-js] .bar {
      column-gap: 0.6rem;
    }
    .quick {
      font-size: 0.84rem;
    }
    .menu-toggle:not([hidden]) {
      min-width: 3.7rem;
      padding: 0 0.6rem;
    }
  }
  /* below this width the three no longer fit on one row: the shortcut gives way,
     and remains the first item in the menu */
  @media (max-width: 23.4rem) {
    .quick {
      display: none;
    }
  }

  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-sunken);
    margin-top: clamp(3rem, 8vw, 6rem);
    padding-block: 2.5rem 2rem;
    font-size: 0.92rem;
    color: var(--fg-muted);
  }
  .foot {
    display: grid;
    gap: 1.5rem 3rem;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
  }
  .foot p {
    max-width: 30rem;
    margin: 0.4rem 0 0;
  }
  .foot ul {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 2;
    column-gap: 2rem;
  }
  .foot .fine {
    grid-column: 1 / -1;
    max-width: none;
    padding-top: 1.2rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
  }
  @media (max-width: 40rem) {
    .foot {
      grid-template-columns: 1fr;
    }
  }
</style>
