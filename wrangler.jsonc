{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "whosonfirst-ai",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "previews": {}
}
