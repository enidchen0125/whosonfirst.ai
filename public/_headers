# Sent with every page and file the site serves. (The host does not add them to
# its own "not found" response.) The site is static: it sets no cookies, takes no
# input and loads nothing from another origin. These headers hold it to that.
#
# script-src and style-src allow inline code because the theme switch has to
# run before the first paint, and code samples and diagrams are colored and
# laid out with style attributes. Everything else must come from this origin.
#
# Link tells a program where the list of pages in Markdown is. Vary is there
# because the host can be set to answer a request that asks for Markdown
# (Accept: text/markdown) with a page's Markdown copy at the page's own address.
#
# If something from another origin is ever added (analytics, an embed, a font),
# it has to be allowed here as well. `npm run check:rendered` serves the built
# site with these headers and fails if any page breaks them.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Link: </llms.txt>; rel="describedby"; type="text/plain", </sitemap.xml>; rel="sitemap"
  Vary: Accept

# The Markdown copies of the pages, and the two files that list them, are for
# programs that read. A search engine should send people to the page itself.
/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
/llms.txt
  X-Robots-Tag: noindex
/llms-full.txt
  X-Robots-Tag: noindex

# The host sends a .txt file as text/plain and names no encoding, and a browser
# then reads it as Windows-1252: every curly quote and dash comes out as three
# wrong characters. These files are UTF-8, so say so.
/*.txt
  Content-Type: text/plain; charset=utf-8
